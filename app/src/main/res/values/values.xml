<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0B1220</color>
    <color name="card">#141C2E</color>
    <color name="text">#E6EDF7</color>
    <color name="muted">#94A3B8</color>

    <string name="loc_access">Autoriser la localisation</string>
    <string name="pick_app">Choisis l\'appli (appui long sur la tuile pour changer)</string>
    <string name="no_app">Aucune appli trouvée</string>

    <style name="Theme.Launcher" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="accentColor">#2F6FED</item>
        <item name="android:colorAccent">#2F6FED</item>
    </style>
    <style name="Theme.Launcher.Red"><item name="accentColor">#D13438</item><item name="android:colorAccent">#D13438</item></style>
    <style name="Theme.Launcher.Green"><item name="accentColor">#218358</item><item name="android:colorAccent">#218358</item></style>
    <style name="Theme.Launcher.Orange"><item name="accentColor">#D9480F</item><item name="android:colorAccent">#D9480F</item></style>
    <style name="Theme.Launcher.Purple"><item name="accentColor">#7C3AED</item><item name="android:colorAccent">#7C3AED</item></style>
    <style name="Theme.Launcher.Cyan"><item name="accentColor">#0369A1</item><item name="android:colorAccent">#0369A1</item></style>

    <style name="Stat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TileBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background">@drawable/tile</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>
    <style name="TileBoxAccent" parent="TileBox">
        <item name="android:background">@drawable/tile_accent</item>
    </style>
    <style name="TileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="TileLabelAccent" parent="TileLabel">
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>
