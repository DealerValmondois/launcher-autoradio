<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="?attr/bgColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/back"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:background="@drawable/tile"
            android:drawableStart="@drawable/ic_prev"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:text="Retour"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:stateListAnimator="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Réglages"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="COULEUR"
        android:textColor="?attr/accentColor"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <SeekBar
            android:id="@+id/hue"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:max="23"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:contentDescription="Teinte" />
        <View
            android:id="@+id/preview"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/tile_accent" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Glisse pour choisir, le reste des couleurs s'adapte tout seul"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/android_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            android:background="@drawable/tile"
            android:drawableStart="@drawable/ic_settings"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Réglages Android"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:stateListAnimator="@null" />
        <Button
            android:id="@+id/update"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/tile"
            android:text="Mettre à jour"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
